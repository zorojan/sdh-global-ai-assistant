import { useCallback, useEffect, useRef, useState } from 'react';
import { Modality } from '@google/genai';

import BasicFace from '../basic-face/BasicFace';
import { useLiveAPIContext } from '../../../contexts/LiveAPIContext';
import { createSystemInstructions } from '@/lib/prompts';
import { useAgent, useUser } from '@/lib/state';

export default function KeynoteCompanionWithRAG() {
  const { client, connected, setConfig } = useLiveAPIContext();
  const faceCanvasRef = useRef<HTMLCanvasElement>(null);
  const user = useUser();
  const { current } = useAgent();
  const [configLoaded, setConfigLoaded] = useState(false);
  const [ragEnabled, setRagEnabled] = useState(true);
  const [lastRAGCheck, setLastRAGCheck] = useState<string>('');
  const [ragResponseAlert, setRAGResponseAlert] = useState<string>('');
  const [ragResponseCount, setRAGResponseCount] = useState(0);
  // Keep last applied agent id to avoid duplicate reloads
  const lastAgentIdRef = useRef<string | null>(null);

  // БЫСТРЫЙ RAG для real-time аудио диалога
  const checkRAGKnowledge = async (userMessage: string) => {
    const startTime = Date.now();
    
    try {
      console.log(`⚡ [RAG] Быстрая проверка knowledge base для: "${userMessage}"`);
      
      const response = await fetch('http://localhost:3001/api/rag/fast-search', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          query: userMessage,
          language: 'hy-AM',
          company_id: 'd741629c-16e0-4009-9ced-77f406a7e6d0' // FSM
        })
      });

      const duration = Date.now() - startTime;
      
      if (!response.ok) {
        console.log(`⚠️ [RAG] API недоступен (${duration}ms), используем Gemini`);
        return null;
      }

      const ragData = await response.json();
      
      if (ragData.success && ragData.answer) {
        console.log(`⚡ [RAG] Быстрый ответ получен (${duration}ms, similarity: ${ragData.similarity}, cached: ${ragData.cached})`);
        return ragData.answer;
      }
      
      console.log(`📝 [RAG] Точного ответа не найдено (${duration}ms), используем Gemini Live`);
      return null;
      
    } catch (error) {
      const duration = Date.now() - startTime;
      console.error(`❌ [RAG] Ошибка быстрого поиска (${duration}ms):`, error);
      return null;
    }
  };



  // Function to fetch Live API configuration from database with RAG integration
  const fetchLiveApiConfig = async () => {
    try {
      console.log(`🎵 [Agent: ${current.name}] Fetching Live API configuration with RAG integration...`);

      const response = await fetch(`http://localhost:3001/api/public/config/live-connection/${current.id}`);

      if (!response.ok) {
        throw new Error(`Failed to fetch Live API config: ${response.status}`);
      }

      const { connectionConfig, agentInfo } = await response.json();
      
      // Модифицируем system instruction для работы с RAG
      const enhancedSystemInstruction = `${connectionConfig.config?.systemInstruction || ''}\n\nВАЖНО: Ты работаешь в составе гибридной системы с RAG (Retrieval Augmented Generation). Иногда ты получишь готовые ответы от системы знаний FSM. В таких случаях используй эту информацию как основу для своего ответа, но адаптируй её под свою личность и стиль общения. Всегда отвечай на армянском языке.`;

      // Добавляем RAG как function tool в конфигурацию
      const configWithRAG = {
        ...connectionConfig.config,
        systemInstruction: enhancedSystemInstruction,
        tools: [
          {
            functionDeclarations: [
              {
                name: 'search_fsm_knowledge',
                description: 'Ищет информацию в базе знаний FSM (Финансовый омbudsman) на армянском языке. Используй эту функцию когда пользователь задает вопросы о FSM услугах, правилах, процедурах.',
                parameters: {
                  type: 'object',
                  properties: {
                    query: {
                      type: 'string',
                      description: 'Вопрос пользователя для поиска в базе знаний FSM'
                    },
                    language: {
                      type: 'string',
                      description: 'Язык запроса',
                      default: 'hy-AM'
                    }
                  },
                  required: ['query']
                }
              }
            ]
          }
        ]
      };

      console.log(`✅ [Agent: ${current.name}] Live API configuration with RAG loaded:`, {
        model: connectionConfig.model,
        ragEnabled: ragEnabled,
        systemInstructionLength: configWithRAG.systemInstruction.length
      });

      setConfig(configWithRAG);
      setConfigLoaded(true);

    } catch (error) {
      console.error(`❌ [Agent: ${current.name}] Error fetching Live API configuration:`, error);

      // Fallback config with RAG support
      const fallbackConfig = {
        responseModalities: [Modality.AUDIO],
        speechConfig: {
          voiceConfig: {
            prebuiltVoiceConfig: {
              voiceName: "Orus"
            }
          }
        },
        inputAudioTranscription: {},
        outputAudioTranscription: {},
        systemInstruction: `You are FSM Helper, an AI assistant for Financial Services Management. Your tone should be բարյացակամ. You should express ուրախ. ${current.personality}\n\nВАЖНО: Ты работаешь с RAG системой. Используй информацию от knowledge base когда она доступна. Всегда отвечай на армянском языке. Start with a welcome message.`
      };

      setConfig(fallbackConfig);
      setConfigLoaded(true);
    }
  };

  // RAG alert functions for visual feedback
  const showRAGAlert = useCallback((message: string) => {
    console.log(`🔔 [RAG] Alert: ${message}`);
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('RAG Search', { body: message, icon: '🔍' });
    }
  }, []);

  const showRAGSuccess = useCallback((message: string) => {
    console.log(`✅ [RAG] Success: ${message}`);
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('RAG Success', { body: message, icon: '✅' });
    }
  }, []);

  const showRAGError = useCallback((message: string) => {
    console.log(`❌ [RAG] Error: ${message}`);
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('RAG Error', { body: message, icon: '❌' });
    }
  }, []);

  // RAG integration with TIMEOUT for real-time audio  
  const processUserInput = useCallback(async (userMessage: string) => {
    if (!ragEnabled) return false;
    
    setLastRAGCheck(userMessage);
    
    // БЫСТРЫЙ RAG с таймаутом 3 секунды для аудио диалога
    const ragPromise = checkRAGKnowledge(userMessage);
    const timeoutPromise = new Promise((_, reject) => 
      setTimeout(() => reject(new Error('RAG timeout')), 3000)
    );
    
    try {
      console.log('🎯 [RAG] Быстрая проверка knowledge base (3 сек лимит)');
      
      const ragResponse = await Promise.race([ragPromise, timeoutPromise]);
      
      if (ragResponse) {
        console.log('⚡ [RAG] Найден релевантный контент, отправляем мгновенно');
        
        // 🔔 ТРИГГЕР УСПЕШНОГО RAG ОТВЕТА
        const newCount = ragResponseCount + 1;
        setRAGResponseCount(newCount);
        setRAGResponseAlert(`RAG ОТВЕТ #${newCount}: ${ragResponse.substring(0, 50)}...`);
        
        // 🎵 Аудио сигнал успешного RAG
        try {
          const audio = new Audio('data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBjiR1/LMeSwFJHfH8N2QQAoUXrTp66hVFApGn+DyvmYfCjaKzeiTQwkSaLfkoZRJFApDnuPz'); 
          audio.play().catch(() => {}); 
        } catch (e) {}
        
        // 🚨 Browser Notification для RAG успеха
        try {
          if (Notification.permission === 'granted') {
            new Notification('🎯 RAG Ответ доставлен!', {
              body: `Ответ #${newCount}: ${ragResponse.substring(0, 50)}...`,
              icon: '🧠'
            });
          }
        } catch (e) {}
        
        // Отправляем готовый RAG ответ напрямую, без переобработки Gemini
        await client.send({
          text: ragResponse
        }, false);
        
        console.log('✅ [RAG] Быстрый ответ отправлен + триггер активирован');
        console.log('🎯 [RAG ТРИГГЕР] ===== RAG ОТВЕТ ДОСТАВЛЕН =====');
        console.log('📝 [RAG ТРИГГЕР] Ответ:', ragResponse);
        console.log('🔢 [RAG ТРИГГЕР] Количество RAG ответов:', newCount);
        console.log('🎯 [RAG ТРИГГЕР] ===========================');
        
        // Убираем алерт через 5 секунд
        setTimeout(() => setRAGResponseAlert(''), 5000);
        
        return true; // Блокируем Gemini Live
      }
    } catch (error) {
      if (error.message === 'RAG timeout') {
        console.log('⏰ [RAG] Таймаут 3 сек - переходим на Gemini Live для быстрого ответа');
      } else {
        console.error('❌ [RAG] Ошибка:', error);
      }
    }
    
    return false; // Продолжаем с Gemini Live если RAG медленный/не найден
  }, [ragEnabled, client]);

  // Request notification permissions on component mount
  useEffect(() => {
    // Запрашиваем разрешение на уведомления для RAG триггеров
    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission().then(permission => {
        console.log('🔔 [RAG] Notification permission:', permission);
      });
    }
  }, []);

  // Load configuration and setup
  useEffect(() => {
    if (!current?.id || current.id === 'loading' || current.id === 'default') {
      return;
    }

    if (lastAgentIdRef.current === current.id) {
      return;
    }

    console.log('🎭 Agent changed with RAG integration - Current agent:', current.name);
    setConfigLoaded(false);
    lastAgentIdRef.current = current.id;
    fetchLiveApiConfig();
  }, [setConfig, current.id, current.name]);

  // RAG Integration State - теперь перехватываем через send method

  // Setup RAG tool call handling - PROPER GEMINI LIVE INTEGRATION  
  useEffect(() => {
    if (!client || !connected || !ragEnabled) return;

    console.log('� [RAG] Настраиваем обработчик tool call для RAG...');

    // Обработчик tool call - когда Gemini вызывает search_fsm_knowledge
    const handleToolCall = async (toolCall: any) => {
      console.log('🔧 [RAG] Получен tool call:', toolCall);
      
      if (toolCall.name === 'search_fsm_knowledge') {
        const { query, language = 'hy-AM' } = toolCall.args;
        
        console.log(`🔍 [RAG] Выполняем поиск в базе знаний: "${query}"`);
        showRAGAlert(`Ищу в базе знаний: "${query.substring(0, 30)}..."`);
        
        try {
          // Быстрый поиск через RAG API
          const response = await fetch('http://localhost:3001/api/rag/fast-search', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              query,
              language,
              company_id: 'd741629c-16e0-4009-9ced-77f406a7e6d0'
            })
          });

          const ragResult = await response.json();
          
          let toolResponse;
          if (ragResult.success && ragResult.answer) {
            console.log('✅ [RAG] Найден ответ в базе знаний');
            showRAGSuccess('Информация найдена в базе знаний!');
            
            toolResponse = {
              id: toolCall.id,
              functionResponses: [{
                name: 'search_fsm_knowledge',
                response: {
                  success: true,
                  answer: ragResult.answer,
                  similarity: ragResult.similarity,
                  source: 'FSM Knowledge Base'
                }
              }]
            };
          } else {
            console.log('❌ [RAG] Информация не найдена в базе знаний');
            showRAGAlert('Информация не найдена в базе знаний');
            
            toolResponse = {
              id: toolCall.id,
              functionResponses: [{
                name: 'search_fsm_knowledge',
                response: {
                  success: false,
                  message: 'Информация по этому вопросу не найдена в базе знаний FSM. Обратитесь в офис FSM по телефону 060-70-11-11.'
                }
              }]
            };
          }
          
          // Отправляем ответ tool call обратно в Gemini
          client.sendToolResponse(toolResponse);
          console.log('📤 [RAG] Tool response отправлен в Gemini');
          
        } catch (error) {
          console.error('❌ [RAG] Ошибка при выполнении tool call:', error);
          showRAGError('Ошибка при поиске в базе знаний');
          
          // Отправляем ошибку как ответ на tool call
          const errorResponse = {
            id: toolCall.id,
            functionResponses: [{
              name: 'search_fsm_knowledge',
              response: {
                success: false,
                error: 'Ошибка при поиске в базе знаний. Попробуйте позже.'
              }
            }]
          };
          
          client.sendToolResponse(errorResponse);
        }
      }
    };

    // Обработчик для отладки других событий
    const handleContent = (data: any) => {
      console.log('📨 [RAG DEBUG] Content событие:', {
        hasModelTurn: !!data?.modelTurn,
        hasTurnComplete: !!data?.turnComplete,
        hasGroundingMetadata: !!data?.groundingMetadata
      });
    };

    // Добавляем обработчики
    client.on('toolcall', handleToolCall);
    client.on('content', handleContent);

    return () => {
      console.log('🧹 [RAG] Удаляем обработчики tool call...');
      client.off('toolcall', handleToolCall);
      client.off('content', handleContent);
    };
  }, [client, connected, ragEnabled]);

  // Start session
  useEffect(() => {
    if (connected && configLoaded) {
      console.log(`🎤 [Agent: ${current.name}] Starting RAG-enhanced session...`);
      const beginSession = async () => {
        try {
          client.send({
            text: 'Greet the user and introduce yourself as FSM Helper. Mention that you can help with FSM services and general questions.',
          }, true);
          console.log(`✅ [Agent: ${current.name}] RAG-enhanced session started`);
        } catch (error) {
          console.error(`❌ [Agent: ${current.name}] Failed to start session:`, error);
        }
      };
      beginSession();
    }
  }, [client, connected, configLoaded, current.name]);
        
        // Извлекаем текст из частей сообщения
        if (Array.isArray(parts)) {
          userInput = parts
            .filter(part => part.text)
            .map(part => part.text)
            .join(' ');
        } else if (parts && typeof parts === 'object' && parts.text) {
          userInput = parts.text;
        } else if (typeof parts === 'string') {
          userInput = parts;
        }

        if (userInput.trim()) {
          console.log(`🎧 [RAG] Найден пользовательский ввод: "${userInput}"`);
          
          try {
            // Проверяем RAG ПЕРЕД отправкой в Gemini
            const ragResult = await processUserInput(userInput);
            
            if (ragResult) {
              console.log('🛑 [RAG] Блокируем отправку в Gemini - RAG обработал запрос');
              return; // НЕ отправляем в Gemini Live
            } else {
              console.log('📝 [RAG] RAG не сработал, продолжаем с Gemini Live');
            }
          } catch (error) {
            console.error('❌ [RAG] Ошибка при обработке через RAG:', error);
          }
        }

        // Если RAG не сработал, отправляем в оригинальный Gemini
        return originalSend.call(this, parts, turnComplete);
      };
    }

    // Также попробуем перехватить sendRealtimeInput для аудио данных
    const originalSendRealtimeInput = client.sendRealtimeInput;
    if (originalSendRealtimeInput) {
      (client as any).sendRealtimeInput = function(chunks: any) {
        console.log('� [RAG DEBUG] Перехвачен sendRealtimeInput:', chunks);
        
        // Аудио данные нужно сначала распознать в текст
        // Пока просто логируем
        
        return originalSendRealtimeInput.call(this, chunks);
      };
    }

    // Слушаем события для отладки
    const handleContent = (data: any) => {
      console.log('� [RAG DEBUG] Content событие:', {
        hasModelTurn: !!data?.modelTurn,
        hasTurnComplete: !!data?.turnComplete,
        data: data
      });
    };

    const handleSetupComplete = () => {
      console.log('✅ [RAG DEBUG] Setup complete');
    };

    const handleTurnComplete = () => {
      console.log('🔄 [RAG DEBUG] Turn complete');
    };

    // Добавляем обработчики событий
    client.on('content', handleContent);
    client.on('setupcomplete', handleSetupComplete);
    client.on('turncomplete', handleTurnComplete);

    return () => {
      console.log('🧹 [RAG DEBUG] Очищаем обработчики...');
      
      // Восстанавливаем оригинальные методы
      if (originalSend) {
        (client as any).send = originalSend;
      }
      if (originalSendRealtimeInput) {
        (client as any).sendRealtimeInput = originalSendRealtimeInput;
      }
      
      // Удаляем обработчики событий
      client.off('content', handleContent);
      client.off('setupcomplete', handleSetupComplete);
      client.off('turncomplete', handleTurnComplete);
    };
  }, [client, connected, ragEnabled]);

  // Start session
  useEffect(() => {
    if (connected && configLoaded) {
      console.log(`🎤 [Agent: ${current.name}] Starting RAG-enhanced session...`);
      const beginSession = async () => {
        try {
          client.send({
            text: 'Greet the user and introduce yourself as FSM Helper. Mention that you can help with FSM services and general questions.',
          }, true);
          console.log(`✅ [Agent: ${current.name}] RAG-enhanced session started`);
        } catch (error) {
          console.error(`❌ [Agent: ${current.name}] Failed to start session:`, error);
        }
      };
      beginSession();
    }
  }, [client, connected, configLoaded, current.name]);

  return (
    <div className="keynote-companion">
      {/* Enhanced debug info with RAG status */}
      <div className="fixed top-4 right-4 bg-black/80 text-white p-3 rounded text-xs font-mono z-50 max-w-sm">
        <div className="mb-2 font-bold text-green-400">🧠 Gemini Live + RAG</div>
        <div>Agent: {current.name}</div>
        <div>Connected: {connected ? '✅' : '❌'}</div>
        <div>Config Loaded: {configLoaded ? '✅' : '❌'}</div>
        <div>RAG Enabled: {ragEnabled ? '✅' : '❌'}</div>
        
        {/* RAG Success Counter */}
        {ragResponseCount > 0 && (
          <div className="mt-2 p-2 bg-green-700/50 border border-green-400 rounded">
            <div className="font-bold text-green-300">🎯 RAG ОТВЕТЫ: {ragResponseCount}</div>
          </div>
        )}

        {/* Active RAG Alert */}
        {ragResponseAlert && (
          <div className="mt-2 p-2 bg-yellow-600/70 border border-yellow-400 rounded animate-pulse">
            <div className="font-bold text-yellow-200">🔔 RAG ТРИГГЕР</div>
            <div className="text-xs text-yellow-100 mt-1">{ragResponseAlert}</div>
          </div>
        )}

        {lastRAGCheck && (
          <div className="mt-2 text-yellow-300">
            <div>Last RAG Check:</div>
            <div className="text-xs opacity-75">"{lastRAGCheck.substring(0, 30)}..."</div>
          </div>
        )}
        
        <button
          onClick={() => setRagEnabled(!ragEnabled)}
          className={`mt-2 px-2 py-1 rounded text-xs ${
            ragEnabled ? 'bg-green-600' : 'bg-gray-600'
          }`}
        >
          {ragEnabled ? 'RAG ON' : 'RAG OFF'}
        </button>
        
        {ragResponseCount > 0 && (
          <button
            onClick={() => {
              setRAGResponseCount(0);
              setRAGResponseAlert('');
            }}
            className="mt-1 ml-2 px-2 py-1 rounded text-xs bg-red-600 hover:bg-red-700"
          >
            RESET
          </button>
        )}
      </div>

      <BasicFace
        canvasRef={faceCanvasRef!}
        color={current.bodyColor}
        avatarUrl={current.avatarUrl}
        isActive={connected}
      />
    </div>
  );
}