# Ignore admin panel during Vercel deployment
admin-panel/
admin-panel/**
**/admin-panel/**
**/next.config.js

# Ignore development files
*.log
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore build artifacts
.next/
.vercel/
dist/
build/

# Ignore node_modules (handled by Vercel)
node_modules/

# Ignore development tools
.vscode/
.idea/
*.swp
*.swo

# Ignore test files
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts