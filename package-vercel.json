{
  "name": "sdh-global-ai-assistant-vercel",
  "private": true,
  "version": "1.0.0",
  "description": "SDH Global AI Assistant - Vercel deployment version",
  "scripts": {
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "echo 'No shared build needed'",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm start",
    "install:production": "npm install --only=production --workspace=frontend --workspace=backend"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5", 
    "helmet": "^7.1.0",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0"
  },
  "keywords": [
    "ai",
    "assistant",
    "gemini",
    "react",
    "express"
  ],
  "author": "SDH Global",
  "license": "MIT"
}