{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/agents",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/agents/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/settings",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/settings/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/auth",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/realtime",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/realtime/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/admin$",
      "dest": "https://sdh-global-ai-assistant-admin-panel-7lqv3yxu1.vercel.app/"
    },
    {
      "src": "^/admin/(.*)",
      "dest": "https://sdh-global-ai-assistant-admin-panel-7lqv3yxu1.vercel.app/$1"
    },
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/widget.html",
      "dest": "/frontend/widget.html"
    },
    {
      "src": "/test-openai-realtime.html",
      "dest": "/frontend/test-openai-realtime.html"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|gif|woff|woff2|ttf|eot))$",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}