{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/agents",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/agents/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/settings",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/settings/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/auth",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/realtime",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/realtime/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}